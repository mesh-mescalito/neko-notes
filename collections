*{box-sizing:border-box;margin:0;padding:0}body{min-height:100dvh;background:radial-gradient(circle at 8% 4%,rgba(204,234,255,.8),transparent 28%),radial-gradient(circle at 92% 8%,rgba(235,211,255,.7),transparent 26%),radial-gradient(circle at 78% 86%,rgba(211,255,238,.62),transparent 28%),var(--bg);color:var(--ink);font-family:Nunito,system-ui,sans-serif;padding:18px}.container{max-width:900px;margin:auto}.header{text-align:center;position:relative;padding:14px 0 24px}.cat{font-family:'Press Start 2P',monospace;font-size:.7rem;line-height:1.3;white-space:pre;display:inline-block;background:var(--holo);background-size:220% 100%;background-clip:text;-webkit-background-clip:text;color:transparent;animation:wiggle 3.5s ease-in-out infinite,holoShift 12s linear infinite}.brand h1{font-size:clamp(1.55rem,5vw,2.4rem);font-weight:900;letter-spacing:-.045em;margin-top:9px}.subtitle{color:var(--muted);font-size:.94rem;font-weight:800;margin-top:4px}.paw{position:absolute;font-size:1.65rem;opacity:.45;animation:float 3s ease-in-out infinite}.paw.one{top:12px;left:8%;transform:rotate(-18deg)}.paw.two{right:8%;top:34px;animation-delay:1s;transform:rotate(18deg)}@keyframes wiggle{0%,100%{transform:rotate(-2deg)}50%{transform:rotate(2deg)}}@keyframes float{0%,100%{translate:0 0}50%{translate:0 -10px}}@keyframes holoShift{to{background-position:220% 0}}@keyframes pop{0%{transform:scale(.96);opacity:0}100%{transform:scale(1);opacity:1}}
.mode-selector{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));gap:8px;margin-bottom:22px}.mode-btn{min-height:68px;border:2px solid var(--border);border-radius:18px;background:var(--surface);backdrop-filter:blur(12px);color:var(--ink);box-shadow:var(--shadow);padding:9px 4px 7px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:4px;font-weight:900;transition:.16s ease}.mode-btn:hover,.mode-btn:active{transform:translateY(-2px);border-color:var(--accent)}.mode-btn.active{background:var(--holo);background-size:220% 100%;animation:holoShift 12s linear infinite;color:#343451;border-color:rgba(255,255,255,.84);box-shadow:0 6px 0 rgba(111,114,178,.22)}.jp{font-family:'Press Start 2P',monospace;font-size:.63rem}.es{font-size:.64rem;line-height:1;font-weight:900}.mode-content{display:none}.mode-content.active{display:block;animation:pop .22s ease}.panel,.note-card,.project-card{background:var(--surface);border:2px solid var(--border);border-radius:22px;box-shadow:var(--shadow);backdrop-filter:blur(12px)}.panel{padding:18px}textarea,#writeArea,.field-input,.modal input{width:100%;border:2px solid var(--border);border-radius:16px;background:var(--surface-strong);color:var(--ink);padding:14px;font-size:1rem;line-height:1.55;outline:none}#writeArea{min-height:230px;resize:vertical}textarea:focus,input:focus{border-color:var(--accent);box-shadow:0 0 0 4px rgba(139,154,235,.16)}.btn{border:2px solid rgba(88,99,180,.48);border-radius:14px;background:var(--holo);background-size:220% 100%;color:#353553;padding:12px 15px;margin-top:14px;font-size:.9rem;font-weight:900;box-shadow:0 4px 0 rgba(95,107,173,.25);transition:.15s}.btn:hover,.btn:active{transform:translateY(-2px);background-position:220% 0}.btn-secondary{background:var(--surface-strong);color:var(--ink);border-color:var(--border);box-shadow:none}.btn-danger{background:#e77a91;color:#fff;border-color:#bd5069}.btn-small{padding:9px 11px;font-size:.78rem;margin-top:0}.stats{text-align:center;color:var(--muted);font-weight:800;margin-bottom:14px}.notes-list{max-height:650px;overflow:auto;padding-right:3px}.note-card{padding:16px;margin-bottom:14px}.note-header{display:flex;gap:10px;justify-content:space-between;align-items:flex-start;margin-bottom:10px}.note-timestamp{font-size:.78rem;color:var(--muted);font-weight:800}.note-tags{display:flex;gap:6px;justify-content:flex-end;flex-wrap:wrap}.note-category,.origin-tag,.project-tag{font-size:.73rem;color:#fff;border-radius:999px;padding:6px 9px;font-weight:900}.origin-tag{background:#8270b9}.project-tag{background:#6377a6}.note-text{white-space:pre-wrap;overflow-wrap:anywhere;line-height:1.6}.category-selector,.project-selector,.note-actions,.edit-controls,.backup-actions,.classify-controls{display:flex;gap:8px;flex-wrap:wrap;margin-top:13px}.chip{border:2px solid rgba(255,255,255,.52);border-radius:999px;padding:8px 11px;color:#fff;font-weight:900;font-size:.78rem;box-shadow:0 3px 0 rgba(0,0,0,.16)}.chip.neutral{background:var(--muted);color:#fff}.chip.selected{outline:3px solid var(--ink);outline-offset:2px}.selector-title{font-size:.78rem;font-weight:900;color:var(--muted);margin-top:16px}.new-category-form{display:flex;gap:8px;margin-top:14px}.new-category-form input{min-width:0;padding:10px;font-size:.85rem}.color-picker{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}.color-option{width:36px;height:36px;border:3px solid var(--surface-strong);border-radius:50%;box-shadow:0 2px 0 rgba(0,0,0,.2)}.empty-state{text-align:center;padding:48px 16px;color:var(--muted);font-weight:800}.empty-state .big{font-size:2.4rem;margin-bottom:8px}.hint,.import-note{font-size:.8rem;line-height:1.45;color:var(--muted);text-align:center;font-weight:800;margin:0 auto 14px;max-width:58ch}.filter-section h2{font-size:1rem;margin-bottom:10px}.footer-tip{text-align:center;color:var(--muted);font-size:.76rem;font-weight:800;padding:18px 0 4px}.project-groups{display:grid;gap:18px}.group-title{font-size:.73rem;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);font-weight:900;margin:0 0 8px 6px}.project-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:10px}.project-card{padding:14px;cursor:pointer;transition:.16s}.project-card:hover,.project-card:active{transform:translateY(-2px);border-color:var(--accent)}.project-top{display:flex;justify-content:space-between;align-items:center;gap:10px}.project-name{font-weight:900;font-size:1rem}.project-icon{font-size:1.45rem}.project-meta{font-size:.78rem;font-weight:800;color:var(--muted);margin-top:4px}.project-actions{display:flex;gap:6px;flex-wrap:wrap;margin-top:12px}.project-view-head{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:14px}.project-view-head h2{font-size:1.1rem}.help-button{position:fixed;right:18px;bottom:18px;width:48px;height:48px;border-radius:50%;border:2px solid rgba(255,255,255,.8);background:var(--holo);background-size:220% 100%;box-shadow:0 5px 0 rgba(95,107,173,.25);font-size:1.15rem;font-weight:900;z-index:4}.modal-backdrop{position:fixed;inset:0;background:rgba(28,29,56,.45);display:none;align-items:end;justify-content:center;padding:16px;z-index:8}.modal-backdrop.show{display:flex}.modal{width:min(640px,100%);max-height:86dvh;overflow:auto;background:var(--surface-strong);border:2px solid var(--border);border-radius:24px 24px 18px 18px;padding:20px;box-shadow:0 -8px 30px rgba(35,35,66,.22)}.modal h2{font-size:1.14rem;margin-bottom:7px}.modal p{color:var(--muted);font-weight:800;font-size:.84rem;line-height:1.45}.modal-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:14px}.export-list,.icon-grid{display:grid;gap:8px;margin-top:14px}.export-option{text-align:left;width:100%;border:2px solid var(--border);border-radius:16px;background:var(--surface);padding:12px;color:var(--ink);font-weight:900}.export-option small{display:block;color:var(--muted);font-weight:800;margin-top:3px}.icon-grid{grid-template-columns:repeat(8,1fr)}.icon-choice{font-size:1.3rem;border:2px solid var(--border);background:var(--surface);border-radius:13px;min-height:43px}.icon-choice.selected{outline:3px solid var(--accent);outline-offset:2px}.field-label{display:block;font-size:.78rem;color:var(--muted);font-weight:900;margin:14px 0 6px}.notice{font-size:.77rem;color:var(--muted);font-weight:800;margin-top:10px}@media(max-width:720px){.mode-selector{grid-template-columns:repeat(3,1fr)}body{padding:12px}.panel{padding:14px}.brand h1{font-size:1.65rem}}@media(max-width:380px){.mode-selector{gap:6px}.mode-btn{min-height:61px}.jp{font-size:.56rem}.es{font-size:.59rem}.chip{font-size:.7rem}.icon-grid{grid-template-columns:repeat(6,1fr)}}
</style>
