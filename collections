<style>
:root{--bg:#f7f8ff;--surface:rgba(255,255,255,.78);--surface-strong:rgba(255,255,255,.94);--ink:#393952;--muted:#74738e;--border:rgba(124,138,202,.28);--accent:#7380d7;--accent-dark:#5864b9;--shadow:0 6px 0 rgba(107,119,183,.13);--holo:linear-gradient(110deg,#c8eaff 0%,#e6cefe 22%,#ffd9e8 42%,#fff1bf 62%,#c6f1df 80%,#c0ddff 100%)}
