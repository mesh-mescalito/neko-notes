<body>
<div class="container">
<header class="header"><span class="paw one">🐾</span><span class="paw two">🐾</span><div class="cat"> /\_/\\
( o.o )
 &gt; ^ &lt;</div><div class="brand"><h1>🐱 Neko Notes</h1></div><p class="subtitle">ネコノート · collections of brain crumbs</p></header>
<nav class="mode-selector" aria-label="Modos"><button class="mode-btn active" data-mode="write"><span class="jp">🐈 書く</span><span class="es">Escribir</span></button><button class="mode-btn" data-mode="classify"><span class="jp">🏷️ 分類</span><span class="es">Clasificar</span></button><button class="mode-btn" data-mode="explore"><span class="jp">🎲 探索</span><span class="es">Explorar</span></button><button class="mode-btn" data-mode="all"><span class="jp">📋 全て</span><span class="es">Ver todas</span></button><button class="mode-btn" data-mode="manage"><span class="jp">✏️ 編集</span><span class="es">Editar · copia</span></button><button class="mode-btn" data-mode="projects"><span class="jp">🗂️ プロジェクト</span><span class="es">Proyectos</span></button></nav>
<main>
<section id="writeMode" class="mode-content active"><div class="panel"><textarea id="writeArea" placeholder="Escribe aquí una nota... 🐾"></textarea><p class="selector-title">Tag / categoría (opcional)</p><div id="writeCategorySelector" class="category-selector"></div><p class="selector-title">Proyecto (opcional)</p><div id="writeProjectSelector" class="project-selector"></div><button class="btn" onclick="saveNote()">🐾 Guardar nota</button></div></section>
<section id="classifyMode" class="mode-content"><div class="stats">🐈 Sin clasificar: <strong id="unclassifiedCount">0</strong></div><div id="classifyCard"></div></section>
<section id="exploreMode" class="mode-content"><div class="panel filter-section"><h2>🎲 Explora tus notas</h2><p class="hint">Elige una o más categorías y Neko te enseñará una nota al azar.</p><div id="exploreCategories" class="category-selector"></div><button class="btn" onclick="loadRandomNote()">🎲 Nota al azar</button></div><div id="exploreCard" style="margin-top:14px"></div></section>
<section id="allMode" class="mode-content"><div class="stats">📋 Total: <strong id="totalCount">0</strong> notas</div><div id="allNotesList" class="notes-list"></div></section>
<section id="manageMode" class="mode-content"><div class="stats">✏️ Editar y hacer copia: <strong id="manageCount">0</strong> notas</div><div class="backup-actions"><button class="btn btn-small" onclick="openExportSheet()">📤 Exportar</button><button class="btn btn-small btn-secondary" onclick="document.getElementById('importFile').click()">📥 Importar</button><input id="importFile" type="file" accept="application/json,.json" hidden onchange="importNotes(event)"></div><p class="import-note">Exporta todo, una categoría o un proyecto. Al combinar notas de otra persona, puedes hacerlas tuyas o marcar su origen.</p><div id="manageNotesList" class="notes-list"></div></section>
<section id="projectsMode" class="mode-content"><div id="projectsHome"></div></section>
</main><p class="footer-tip">🐾 Las notas se guardan en este navegador · exporta una copia para tenerlas a salvo</p>
</div>
<button class="help-button" aria-label="Mini guía gatuna" onclick="openModal('helpModal')">🐾?</button>
<div id="helpModal" class="modal-backdrop" onclick="closeOnBackdrop(event,'helpModal')"><div class="modal"><h2>🐱 psst, human...</h2><p><strong>tags</strong> = tiny labels.<br>“what kind of brain crumb iz dis?”</p><p style="margin-top:10px"><strong>projects</strong> = a home for many crumbs.<br>“what am I keeping track of?”</p><p style="margin-top:10px">a note can haz both. or neither. no panic. meow. 🐾</p><div class="modal-actions"><button class="btn btn-small" onclick="closeModal('helpModal')">miau, entendido</button></div></div></div>
<div id="exportModal" class="modal-backdrop" onclick="closeOnBackdrop(event,'exportModal')"><div class="modal"><h2>📤 Exportar notas</h2><p>Elige una copia completa o comparte solo una categoría o proyecto.</p><div id="exportOptions" class="export-list"></div><div class="modal-actions"><button class="btn btn-small btn-secondary" onclick="closeModal('exportModal')">Cerrar</button></div></div></div>
<div id="importChoiceModal" class="modal-backdrop" onclick="closeOnBackdrop(event,'importChoiceModal')"><div class="modal"><h2>🐾 ¿Cómo quieres añadir estas notas?</h2><p>Las notas nuevas conservarán sus categorías y proyectos cuando existan.</p><div class="modal-actions"><button class="btn btn-small" onclick="chooseImportStyle('mine')">✨ Integrarlas como mías</button><button class="btn btn-small btn-secondary" onclick="chooseImportStyle('origin')">👤 Conservar de quién son</button></div></div></div>
<div id="originModal" class="modal-backdrop" onclick="closeOnBackdrop(event,'originModal')"><div class="modal"><h2>🐱 ¿Quién te compartió estas notas?</h2><p>Solo las notas nuevas de esta importación tendrán esta mini etiqueta. Tus notas no cambiarán.</p><label class="field-label" for="originName">Nombre o grupo</label><input id="originName" placeholder="Ejemplo: Marta, Dani o Club de cine"><div class="modal-actions"><button class="btn btn-small" onclick="finishImportWithOrigin()">Guardar etiqueta</button><button class="btn btn-small btn-secondary" onclick="finishImportWithOrigin(true)">Integrarlas como mías</button></div></div></div>
<div id="projectModal" class="modal-backdrop" onclick="closeOnBackdrop(event,'projectModal')"><div class="modal"><h2 id="projectModalTitle">✨ Nuevo proyecto</h2><label class="field-label" for="projectName">Nombre</label><input id="projectName" placeholder="Ejemplo: Viaje a Japón"><label class="field-label">Elige un icono</label><div id="iconGrid" class="icon-grid"></div><label class="field-label"><input id="projectDone" type="checkbox"> Es una lista completada (✅ delante del icono)</label><div class="modal-actions"><button class="btn btn-small" onclick="saveProjectFromModal()">Guardar proyecto</button><button class="btn btn-small btn-secondary" onclick="closeModal('projectModal')">Cancelar</button></div><p id="projectModalNotice" class="notice"></p></div></div>
<script>
let notes=JSON.parse(localStorage.getItem('quickNotes')||'[]');
let categories=JSON.parse(localStorage.getItem('quickCategories')||'[]');
let projects=JSON.parse(localStorage.getItem('nekoProjects')||'null') || defaultProjects();
let currentClassifyIndex=0,selectedWriteCategory=null,selectedWriteProject=null,pendingImport=null,editingProjectId=null,chosenIcon='✨';
const selectedExploreCategories=new Set();
const colors=['#ef6b8a','#f08a5d','#e9b949','#a9c957','#74bfa5','#57b7c9','#6e9cea','#9d83d4','#c27ac0','#e8759b'];
const icons=['✨','🐈','🪐','🧪','🧠','🎮','🎨','🌱','🗺️','📖','🍜','🧵','🌙','💌','🔮','🧩','🎬','📚','🎧','🍿','🕹️','🪴','☕','🧁','🛸','🪄','🎭','🏰','🦋','🌈','🦄','🧸'];
function defaultProjects(){return[
{id:'movies-watch',name:'Películas que ver',icon:'🎬',done:false,hidden:false,default:true},
{id:'movies-seen',name:'Películas que vi',icon:'🎬',done:true,hidden:false,default:true},
{id:'comics-read',name:'Cómics que leer',icon:'📚',done:false,hidden:false,default:true},
{id:'comics-done',name:'Cómics que leí',icon:'📚',done:true,hidden:false,default:true},
{id:'songs-listen',name:'Canciones que escuchar',icon:'🎧',done:false,hidden:false,default:true},
{id:'songs-heard',name:'Canciones que escuché',icon:'🎧',done:true,hidden:false,default:true},
{id:'ideas-for',name:'Ideas para…',icon:'💡',done:false,hidden:false,default:true}
]}
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const sid=v=>String(v).replace(/[^a-zA-Z0-9_-]/g,'_'); const nid=()=>Date.now()+'-'+Math.random().toString(16).slice(2);
function normalizeNotes(){notes=notes.map(n=>({...n,id:n.id??nid(),category:typeof n.category==='string'?n.category:null,projectId:typeof n.projectId==='string'?n.projectId:null,origin:typeof n.origin==='string'?n.origin:null}));}
normalizeNotes();
function save(){localStorage.setItem('quickNotes',JSON.stringify(notes));localStorage.setItem('quickCategories',JSON.stringify(categories));localStorage.setItem('nekoProjects',JSON.stringify(projects));}
function sorted(arr=notes){return [...arr].sort((a,b)=>new Date(b.timestamp)-new Date(a.timestamp));}
function date(iso){const d=new Date(iso),n=new Date(),m=Math.floor((n-d)/60000),h=Math.floor((n-d)/3600000),days=Math.floor((n-d)/86400000);if(m<1)return'Ahora';if(m<60)return`Hace ${m} min`;if(h<24)return`Hace ${h} h`;if(days<7)return`Hace ${days} d`;return d.toLocaleDateString('es-ES',{day:'numeric',month:'short',year:d.getFullYear()!==n.getFullYear()?'numeric':undefined});}
function getProject(id){return projects.find(p=>p.id===id)}
function projectLabel(p){return p?(p.done?'✅ ':'')+p.icon+' '+p.name:''}
function originBadge(n){return n.origin?`<span class="origin-tag">↳ ${esc(n.origin)}</span>`:''}
function projectBadge(n){const p=getProject(n.projectId);return p?`<span class="project-tag">${esc(projectLabel(p))}</span>`:''}
function switchMode(m){document.querySelectorAll('.mode-btn').forEach(b=>b.classList.toggle('active',b.dataset.mode===m));document.querySelectorAll('.mode-content').forEach(x=>x.classList.remove('active'));document.getElementById(m+'Mode').classList.add('active');if(m==='classify')classify();if(m==='explore')explore();if(m==='all')all();if(m==='manage')manage();if(m==='projects')renderProjectsHome();if(m==='write')renderSelectors();}
function renderSelectors(){
const c=document.getElementById('categorySelector');if(c)c.innerHTML=categories.map(x=>`<button class="chip" style="background:${x.color}" onclick='assign(${JSON.stringify(x.name)})'>${esc(x.name)}</button>`).join('');
const w=document.getElementById('writeCategorySelector');if(w)w.innerHTML=categories.map(x=>`<button class="chip ${selectedWriteCategory===x.name?'selected':''}" style="background:${x.color}" onclick='pickCategory(${JSON.stringify(x.name)})'>${esc(x.name)}</button>`).join('');
const p=document.getElementById('writeProjectSelector');if(p){const visible=projects.filter(x=>!x.hidden);p.innerHTML=`<button class="chip neutral ${!selectedWriteProject?'selected':''}" onclick="pickProject(null)">🐾 Sin proyecto</button>`+visible.map(x=>`<button class="chip ${selectedWriteProject===x.id?'selected':''}" style="background:#6377a6" onclick='pickProject(${JSON.stringify(x.id)})'>${esc(projectLabel(x))}</button>`).join('');}
}
function pickCategory(n){selectedWriteCategory=selectedWriteCategory===n?null:n;renderSelectors()}function pickProject(id){selectedWriteProject=selectedWriteProject===id?null:id;renderSelectors()}
function saveNote(){const text=document.getElementById('writeArea').value.trim();if(!text)return;notes.push({id:nid(),text,timestamp:new Date().toISOString(),category:selectedWriteCategory||null,projectId:selectedWriteProject||null,origin:null});save();document.getElementById('writeArea').value='';selectedWriteCategory=null;selectedWriteProject=null;renderSelectors();alert('🐾 Nota guardada')}
function classify(){const un=notes.filter(n=>!n.category);document.getElementById('unclassifiedCount').textContent=un.length;if(!un.length){document.getElementById('classifyCard').innerHTML=empty('🎉','¡Todo está clasificado!','Puedes crear otra nota cuando quieras.');return}currentClassifyIndex=Math.floor(Math.random()*un.length);const n=un[currentClassifyIndex],i=sid(n.id);document.getElementById('classifyCard').innerHTML=`<article class="note-card"><div class="note-header"><span class="note-timestamp">${date(n.timestamp)}</span><div class="note-tags">${projectBadge(n)}${originBadge(n)}</div></div><div class="note-text" id="noteText${i}">${esc(n.text)}</div><div class="note-actions"><button class="btn btn-small btn-secondary" onclick='openEdit(${JSON.stringify(n.id)},"editArea","noteText","editText","saveClass","cancelClass")'>✏️ Editar texto</button><button class="btn btn-small btn-secondary" onclick='del(${JSON.stringify(n.id)},"classify")'>🗑️ Borrar</button></div><div id="editArea${i}"></div><p class="selector-title">Elige categoría</p><div id="categorySelector" class="category-selector"></div><div class="new-category-form"><input class="field-input" id="newCategoryName" placeholder="Nueva categoría..."><button class="btn" onclick="showColors()">+ color</button></div><div id="colorPicker" style="display:none"><div class="color-picker">${colors.map(c=>`<button class="color-option" style="background:${c}" onclick="newCat('${c}')" aria-label="Elegir color"></button>`).join('')}</div></div><div class="classify-controls"><button class="btn btn-small btn-secondary" onclick="classify()">⏭️ Otra nota</button></div></article>`;renderSelectors()}
function assign(cat){const un=notes.filter(n=>!n.category),n=un[currentClassifyIndex];if(!n)return;n.category=cat;save();classify()}function showColors(){const x=document.getElementById('colorPicker');x.style.display=x.style.display==='none'?'block':'none'}function newCat(color){const input=document.getElementById('newCategoryName'),name=input.value.trim();if(!name)return;if(categories.some(c=>c.name.toLowerCase()===name.toLowerCase()))return alert('Esa categoría ya existe');categories.push({name,color});save();input.value='';document.getElementById('colorPicker').style.display='none';renderSelectors()}
function explore(){document.getElementById('exploreCategories').innerHTML=categories.map(c=>`<button class="chip ${selectedExploreCategories.has(c.name)?'selected':''}" style="background:${c.color}" onclick='toggle(${JSON.stringify(c.name)},this)'>${esc(c.name)}</button>`).join('');document.getElementById('exploreCard').innerHTML=''}function toggle(n,e){if(selectedExploreCategories.has(n)){selectedExploreCategories.delete(n);e.classList.remove('selected')}else{selectedExploreCategories.add(n);e.classList.add('selected')}}function loadRandomNote(){if(!selectedExploreCategories.size)return alert('Elige al menos una categoría');const f=notes.filter(n=>selectedExploreCategories.has(n.category));if(!f.length){document.getElementById('exploreCard').innerHTML=empty('🐾','No hay notas aquí','Prueba otra categoría.');return}document.getElementById('exploreCard').innerHTML=readCard(f[Math.floor(Math.random()*f.length)],true)}
function all(){document.getElementById('totalCount').textContent=notes.length;document.getElementById('allNotesList').innerHTML=notes.length?sorted().map(n=>readCard(n)).join(''):empty('🐱','Aún no hay notas','Escribe la primera en la pestaña “Escribir”.')}
function readCard(n,editable=false){const c=n.category&&categories.find(x=>x.name===n.category),i=sid(n.id);return `<article class="note-card"><div class="note-header"><span class="note-timestamp">${date(n.timestamp)}</span><div class="note-tags"><span class="note-category" style="background:${c?.color||'var(--muted)'}">${esc(n.category||'Sin categoría')}</span>${projectBadge(n)}${originBadge(n)}</div></div><div class="note-text" id="${editable?'exploreNoteText'+i:''}">${esc(n.text)}</div>${editable?`<div class="note-actions"><button class="btn btn-small btn-secondary" onclick='openEdit(${JSON.stringify(n.id)},"exploreEditArea","exploreNoteText","exploreEditText","saveExplore","cancelExplore")'>✏️ Editar texto</button></div><div id="exploreEditArea${i}"></div>`:''}</article>`}
function manage(){document.getElementById('manageCount').textContent=notes.length;document.getElementById('manageNotesList').innerHTML=notes.length?sorted().map(manageCard).join(''):empty('🐱','Aún no hay notas','Escribe una primera nota para verla aquí.')}
function manageCard(n){const c=n.category&&categories.find(x=>x.name===n.category),i=sid(n.id),cats=categories.map(x=>`<button class="chip ${n.category===x.name?'selected':''}" style="background:${x.color}" onclick='setCat(${JSON.stringify(n.id)},${JSON.stringify(x.name)})'>${esc(x.name)}</button>`).join(''),projs=projects.filter(x=>!x.hidden).map(x=>`<button class="chip ${n.projectId===x.id?'selected':''}" style="background:#6377a6" onclick='setProject(${JSON.stringify(n.id)},${JSON.stringify(x.id)})'>${esc(projectLabel(x))}</button>`).join('');return `<article class="note-card"><div class="note-header"><span class="note-timestamp">${date(n.timestamp)}</span><div class="note-tags"><span class="note-category" style="background:${c?.color||'var(--muted)'}">${esc(n.category||'Sin categoría')}</span>${projectBadge(n)}${originBadge(n)}</div></div><div class="note-text" id="manageNoteText${i}">${esc(n.text)}</div><div class="note-actions"><button class="btn btn-small btn-secondary" onclick='openEdit(${JSON.stringify(n.id)},"manageEditArea","manageNoteText","manageEditText","saveManage","cancelManage")'>✏️ Editar texto</button><button class="btn btn-small btn-secondary" onclick='del(${JSON.stringify(n.id)},"manage")'>🗑️ Borrar</button></div><div id="manageEditArea${i}"></div><p class="selector-title">Tag / categoría</p><div class="category-selector">${cats}<button class="chip neutral ${!n.category?'selected':''}" onclick='clearCat(${JSON.stringify(n.id)})'>Quitar color</button></div><p class="selector-title">Proyecto</p><div class="project-selector"><button class="chip neutral ${!n.projectId?'selected':''}" onclick='setProject(${JSON.stringify(n.id)},null)'>🐾 Sin proyecto</button>${projs}</div></article>`}
function setCat(id,cat){const n=notes.find(x=>String(x.id)===String(id));if(n){n.category=cat;save();manage()}}function clearCat(id){const n=notes.find(x=>String(x.id)===String(id));if(n){n.category=null;save();manage()}}function setProject(id,pid){const n=notes.find(x=>String(x.id)===String(id));if(n){n.projectId=pid;save();manage()}}
function openEdit(id,area,text,input,saveFn,cancelFn){const n=notes.find(x=>String(x.id)===String(id));if(!n)return;const i=sid(n.id);document.getElementById(area+i).innerHTML=`<div class="edit-mode"><textarea id="${input}${i}">${esc(n.text)}</textarea><div class="edit-controls"><button class="btn btn-small" onclick='${saveFn}(${JSON.stringify(n.id)})'>💾 Guardar</button><button class="btn btn-small btn-secondary" onclick='${cancelFn}(${JSON.stringify(n.id)})'>Cancelar</button></div></div>`;document.getElementById(text+i).style.display='none'}function saveEdit(id,prefix,done){const n=notes.find(x=>String(x.id)===String(id)),input=document.getElementById(prefix+sid(id));if(!n||!input)return;const txt=input.value.trim();if(!txt)return alert('La nota no puede estar vacía');n.text=txt;save();done()}function cancelEdit(id,area,text){const i=sid(id);document.getElementById(area+i).innerHTML='';document.getElementById(text+i).style.display='block'}function saveClass(id){saveEdit(id,'editText',classify)}function cancelClass(id){cancelEdit(id,'editArea','noteText')}function saveExplore(id){saveEdit(id,'exploreEditText',loadRandomNote)}function cancelExplore(id){cancelEdit(id,'exploreEditArea','exploreNoteText')}function saveManage(id){saveEdit(id,'manageEditText',manage)}function cancelManage(id){cancelEdit(id,'manageEditArea','manageNoteText')}function del(id,origin){if(!confirm('¿Borrar esta nota?'))return;notes=notes.filter(n=>String(n.id)!==String(id));save();origin==='manage'?manage():classify()}
function empty(icon,title,text){return `<div class="empty-state"><div class="big">${icon}</div><h3>${title}</h3><p>${text}</p></div>`}
function renderProjectsHome(){const active=projects.filter(p=>!p.hidden&&!p.done),finished=projects.filter(p=>!p.hidden&&p.done),hidden=projects.filter(p=>p.hidden);const card=p=>{const count=notes.filter(n=>n.projectId===p.id).length;return `<article class="project-card" onclick='openProject(${JSON.stringify(p.id)})'><div class="project-top"><div><div class="project-name">${esc(projectLabel(p))}</div><div class="project-meta">${count} nota${count===1?'':'s'}</div></div><span class="project-icon">${p.done?'✅ ':''}${esc(p.icon)}</span></div><div class="project-actions" onclick="event.stopPropagation()"><button class="btn btn-small btn-secondary" onclick='openProjectEditor(${JSON.stringify(p.id)})'>Editar</button><button class="btn btn-small btn-secondary" onclick='toggleProjectHidden(${JSON.stringify(p.id)})'>Ocultar</button></div></article>`};document.getElementById('projectsHome').innerHTML=`<div class="panel" style="margin-bottom:14px"><h2 style="font-size:1.1rem">🗂️ Proyectos</h2><p class="hint" style="text-align:left;margin:7px 0 0">Casitas opcionales para tus esquemas activos. Una nota puede tener un proyecto o vivir tranquilamente sin ninguno.</p><button class="btn" onclick="openProjectEditor()">✨ Crear proyecto</button></div><div class="project-groups"><div><p class="group-title">Activos</p><div class="project-grid">${active.map(card).join('')||empty('🌙','Nada activo todavía','Crea un proyecto cuando te apetezca.')}</div></div><div><p class="group-title">Terminados</p><div class="project-grid">${finished.map(card).join('')||'<p class="hint">Aún no hay colecciones terminadas. Todo a su ritmo. 🐾</p>'}</div></div><div><p class="group-title">Otros</p><div class="project-grid"><article class="project-card" onclick="openProject(null)"><div class="project-top"><div><div class="project-name">🐾 Sin proyecto</div><div class="project-meta">${notes.filter(n=>!n.projectId).length} nota(s) sueltas, libres y felices</div></div><span class="project-icon">🐾</span></div></article></div></div>${hidden.length?`<div><p class="group-title">Ocultos</p><div class="project-grid">${hidden.map(p=>`<article class="project-card"><div class="project-top"><div><div class="project-name">${esc(projectLabel(p))}</div><div class="project-meta">Oculto · ${notes.filter(n=>n.projectId===p.id).length} nota(s)</div></div></div><div class="project-actions"><button class="btn btn-small btn-secondary" onclick='toggleProjectHidden(${JSON.stringify(p.id)})'>Mostrar</button><button class="btn btn-small btn-danger" onclick='deleteProject(${JSON.stringify(p.id)})'>Eliminar</button></div></article>`).join('')}</div></div>`:''}</div>`}
function openProject(id){const p=id?getProject(id):null;const list=sorted(notes.filter(n=>id?n.projectId===id:!n.projectId));document.getElementById('projectsHome').innerHTML=`<div class="panel"><div class="project-view-head"><button class="btn btn-small btn-secondary" onclick="renderProjectsHome()">← Proyectos</button><h2>${p?esc(projectLabel(p)):'🐾 Sin proyecto'}</h2></div><p class="hint" style="text-align:left">${list.length} nota${list.length===1?'':'s'}. ${p?'Puedes cambiar cada nota de proyecto en Editar · copia.':'Aquí viven las notas que no necesitan ninguna casita.'}</p></div><div class="notes-list" style="margin-top:14px">${list.length?list.map(n=>readCard(n)).join(''):empty('🐾','Nada por aquí todavía','Todo proyecto empieza con una pequeña nota.')}</div>`}
function openProjectEditor(id=null){editingProjectId=id;const p=id?getProject(id):null;chosenIcon=p?.icon||'✨';document.getElementById('projectModalTitle').textContent=p?'✏️ Editar proyecto':'✨ Nuevo proyecto';document.getElementById('projectName').value=p?.name||'';document.getElementById('projectDone').checked=!!p?.done;document.getElementById('projectModalNotice').textContent=p?.default?'Este es un proyecto de ayuda inicial: puedes renombrarlo, ocultarlo o eliminarlo si no lo necesitas.':'';renderIconGrid();openModal('projectModal')}
function renderIconGrid(){document.getElementById('iconGrid').innerHTML=icons.map(icon=>`<button class="icon-choice ${chosenIcon===icon?'selected':''}" onclick='chooseIcon(${JSON.stringify(icon)})'>${icon}</button>`).join('')}
function chooseIcon(icon){chosenIcon=icon;renderIconGrid()}
function saveProjectFromModal(){const name=document.getElementById('projectName').value.trim();if(!name)return alert('Ponle un nombre a tu proyecto, human. 🐱');const done=document.getElementById('projectDone').checked;if(editingProjectId){const p=getProject(editingProjectId);Object.assign(p,{name,icon:chosenIcon,done});}else{projects.push({id:'project-'+nid(),name,icon:chosenIcon,done,hidden:false,default:false})}save();closeModal('projectModal');renderProjectsHome()}
function toggleProjectHidden(id){const p=getProject(id);if(!p)return;p.hidden=!p.hidden;save();renderProjectsHome()}function deleteProject(id){const p=getProject(id);if(!p)return;if(!confirm(`¿Eliminar “${p.name}”? Sus notas no se borrarán: pasarán a Sin proyecto.`))return;notes=notes.map(n=>n.projectId===id?{...n,projectId:null}:n);projects=projects.filter(p=>p.id!==id);save();renderProjectsHome()}
function openModal(id){document.getElementById(id).classList.add('show')}function closeModal(id){document.getElementById(id).classList.remove('show')}function closeOnBackdrop(e,id){if(e.target.id===id)closeModal(id)}
function openExportSheet(){const catCounts=categories.map(c=>({kind:'cat',key:c.name,name:c.name,icon:'●',color:c.color,count:notes.filter(n=>n.category===c.name).length})).filter(x=>x.count);const projCounts=projects.map(p=>({kind:'project',key:p.id,name:projectLabel(p),icon:p.icon,color:'#6377a6',count:notes.filter(n=>n.projectId===p.id).length})).filter(x=>x.count);const all=[`<button class="export-option" onclick="exportBackup(notes,categories,projects,'todas-las-notas')">📚 Todas las notas<small>${notes.length} notas, categorías y proyectos</small></button>`,...catCounts.map(x=>`<button class="export-option" onclick='exportCategory(${JSON.stringify(x.key)})'><span style="color:${x.color}">●</span> ${esc(x.name)}<small>${x.count} nota${x.count===1?'':'s'} · solo esta categoría</small></button>`),...projCounts.map(x=>`<button class="export-option" onclick='exportProject(${JSON.stringify(x.key)})'>${esc(x.icon)} ${esc(x.name)}<small>${x.count} nota${x.count===1?'':'s'} · solo este proyecto</small></button>`),notes.some(n=>!n.category)?`<button class="export-option" onclick="exportCategory(null)">⚪ Sin categoría<small>${notes.filter(n=>!n.category).length} nota(s) sin tag</small></button>`:''];document.getElementById('exportOptions').innerHTML=all.join('');openModal('exportModal')}
function exportCategory(name){const selected=notes.filter(n=>n.category===name);const usedCats=name?categories.filter(c=>c.name===name):[];const usedProjs=projects.filter(p=>selected.some(n=>n.projectId===p.id));exportBackup(selected,usedCats,usedProjs,name||'sin-categoria')}
function exportProject(id){const selected=notes.filter(n=>n.projectId===id);const usedCats=categories.filter(c=>selected.some(n=>n.category===c.name));const usedProjs=projects.filter(p=>p.id===id);exportBackup(selected,usedCats,usedProjs,getProject(id)?.name||'proyecto')}
function exportBackup(exportedNotes,exportedCategories,exportedProjects,label){const data={app:'Neko Notes Collections',version:3,exportedAt:new Date().toISOString(),scope:label,notes:exportedNotes,categories:exportedCategories,projects:exportedProjects};const blob=new Blob([JSON.stringify(data,null,2)],{type:'application/json'}),url=URL.createObjectURL(blob),a=document.createElement('a');a.href=url;a.download='neko-notes-'+String(label).toLowerCase().replace(/[^a-z0-9]+/gi,'-').replace(/^-|-$/g,'')+'-'+new Date().toISOString().slice(0,10)+'.json';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(url),1000);closeModal('exportModal')}
function fp(n){return `${n.text}\0${n.timestamp}\0${n.category||''}\0${n.projectId||''}\0${n.origin||''}`}
function importNotes(e){const file=e.target.files?.[0];if(!file)return;const r=new FileReader();r.onload=({target})=>{try{const d=JSON.parse(target.result);if(!Array.isArray(d.notes)||!Array.isArray(d.categories))throw Error();const incoming=d.notes.filter(n=>n&&typeof n.text==='string').map(n=>({id:n.id??nid(),text:n.text,timestamp:n.timestamp&&!isNaN(new Date(n.timestamp))?n.timestamp:new Date().toISOString(),category:typeof n.category==='string'?n.category:null,projectId:typeof n.projectId==='string'?n.projectId:null,origin:typeof n.origin==='string'?n.origin:null}));const incCats=d.categories.filter(c=>c&&typeof c.name==='string'&&typeof c.color==='string');const incProjects=Array.isArray(d.projects)?d.projects.filter(p=>p&&typeof p.id==='string'&&typeof p.name==='string'&&typeof p.icon==='string').map(p=>({id:p.id,name:p.name,icon:p.icon,done:!!p.done,hidden:!!p.hidden,default:!!p.default})):[];const merge=confirm('¿Combinar con las notas de este móvil?\n\nAceptar = combinar.\nCancelar = reemplazar.');pendingImport={incoming,incCats,incProjects,merge};if(merge)openModal('importChoiceModal');else applyImport('mine')}catch{alert('No pude leer ese archivo. Elige una copia .json de Neko Notes.')}e.target.value=''};r.readAsText(file)}
function chooseImportStyle(style){closeModal('importChoiceModal');if(style==='mine')applyImport('mine');else{document.getElementById('originName').value='';openModal('originModal')}}function finishImportWithOrigin(skip=false){const name=skip?'':document.getElementById('originName').value.trim();closeModal('originModal');applyImport(name?'origin':'mine',name||null)}
function uniqueProjectId(oldId){return projects.some(p=>p.id===oldId)?'import-'+nid():oldId}
function applyImport(style,originName=null){if(!pendingImport)return;const{incoming,incCats,incProjects,merge}=pendingImport;let projectMap={};if(merge){const existingByName=new Map(projects.map(p=>[p.name.toLowerCase(),p.id]));incProjects.forEach(p=>{const matched=existingByName.get(p.name.toLowerCase());if(matched)projectMap[p.id]=matched;else{const newId=uniqueProjectId(p.id);projects.push({...p,id:newId,hidden:false});projectMap[p.id]=newId;existingByName.set(p.name.toLowerCase(),newId)}})}else{projects=incProjects.length?incProjects.map(p=>({...p,id:p.id||nid(),hidden:false})):defaultProjects();incProjects.forEach(p=>projectMap[p.id]=p.id)}
let marked=incoming.map(n=>({...n,projectId:n.projectId?(projectMap[n.projectId]||null):null,origin:style==='origin'?(originName||n.origin||null):null}));if(merge){const have=new Set(notes.map(fp)),add=marked.filter(n=>!have.has(fp(n))).map(n=>({...n,id:notes.some(x=>String(x.id)===String(n.id))?nid():n.id}));notes=[...notes,...add];const names=new Set(categories.map(c=>c.name.toLowerCase()));categories=[...categories,...incCats.filter(c=>!names.has(c.name.toLowerCase()))];save();alert(`🐾 ${add.length} notas añadidas${style==='origin'?` · ↳ ${originName}`:''}.`)}else{notes=marked.map(n=>({...n,id:nid()}));categories=incCats;save();alert(`🐾 ${notes.length} notas restauradas.`)}pendingImport=null;renderSelectors();manage()}

document.querySelectorAll('.mode-btn').forEach(b=>b.addEventListener('click',()=>switchMode(b.dataset.mode)));renderSelectors();document.getElementById('writeArea').focus();
</script>
